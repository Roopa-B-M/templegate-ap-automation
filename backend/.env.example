# =====================================================================
# TempleGate AP Automation - backend environment configuration (v1.1)
# Copy this file to `.env` (same folder) and adjust the values.
#   copy .env.example .env      (Windows CMD)
#   cp .env.example .env        (PowerShell / bash)
# =====================================================================

# --- Django core ---
# Secret key for signing sessions/tokens. CHANGE THIS in any real deployment.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL (create the database first) ---
#   psql: CREATE DATABASE templegate_ap;
DB_NAME=templegate_ap
DB_USER=postgres
DB_PASSWORD=RBM@2026
DB_HOST=localhost
DB_PORT=5432
# Alternatively supply a single connection URL (takes precedence):
# DB_URL=postgres://postgres:postgres@localhost:5432/templegate_ap

# --- CORS (React dev server) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- OCR engine ---
# Path to the tesseract executable. Leave empty if `tesseract` is on PATH.
# Windows installer default:
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Business configuration ---
COMPANY_NAME=Templegate Technologies & Services Pvt. Ltd.
COMPANY_ADDRESS=Unit 7, Tech Park One, Baner Road, Pune, Maharashtra 411045
# Checksum-valid demo GSTIN (printed on generated invoices / payment advice).
COMPANY_GSTIN=27AABCT1234A1Z0
COMPANY_STATE_CODE=27
# PO matching tolerances (percent)
TOLERANCE_AMOUNT_PCT=0.5
TOLERANCE_QUANTITY_PCT=0
# Approval SLA defaults (hours)
ESCALATION_DEFAULT_HOURS=48
REMINDER_INTERVAL_HOURS=24

# --- Email ingestion (optional): IMAP inbox polled by `poll_email_inbox` ---
# Leave HOST empty to disable IMAP polling entirely (the scheduler skips it).
EMAIL_INGEST_HOST=
EMAIL_INGEST_PORT=993
EMAIL_INGEST_USER=
EMAIL_INGEST_PASSWORD=

# --- Notification emails (approval requests, reminders, escalations) ---
# Console backend prints emails to the runserver terminal (development).
# For real email set e.g. django.core.mail.backends.smtp.EmailBackend + the
# EMAIL_HOST/EMAIL_PORT/EMAIL_HOST_USER/EMAIL_HOST_PASSWORD settings in .env
# (standard Django settings are read from the environment).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=ap-automation@templegate.example.com

# --- ERP / accounting integration (see backend/accounting/services.py) ---
# Which connector posts purchase vouchers: 'simulated' (default, no network)
# or 'tally_xml' (Tally-compatible XML vouchers, posting still simulated).
ERP_CONNECTOR=simulated

# --- Banking integration (see backend/payments/services.py) ---
# 'simulated' = in-process bank simulation (default, clearly labelled in UI).
# 'file'      = generate NEFT/RTGS bulk payment instruction CSVs for your bank
#               portal + reconcile returned statements (no live bank link).
BANK_GATEWAY=simulated

# --- Extraction: rule-based engine + OPTIONAL AI assist ---
# 'none' (default) = deterministic rule-based extraction only.
# 'llm'            = enable the optional AI assist for low-confidence/missing-
#                    field cases. Needs AI_API_KEY. Any failure degrades
#                    gracefully back to the rule-based result.
AI_EXTRACTION_PROVIDER=none
AI_API_KEY=
AI_MODEL=glm-4-flash
# AI_API_BASE=https://api.openai.com/v1   (OpenAI-compatible chat completions URL)
# Assist triggers only when overall confidence is below this (0..1):
AI_ASSIST_CONFIDENCE_THRESHOLD=0.75
# Timeout for the assist HTTP call (seconds):
AI_ASSIST_TIMEOUT_SECONDS=20

# --- In-process background scheduler (core/scheduler.py, APScheduler) ---
# True = start the scheduler with runserver / WSGI servers. It NEVER starts
# during migrate/test/shell, and starts only once under the autoreloader.
SCHEDULER_ENABLED=False
# Job intervals (seconds, minimums enforced: workflow 30s, OCR 30s, email 60s)
SCHEDULER_WORKFLOW_SECONDS=300
SCHEDULER_OCR_SECONDS=60
SCHEDULER_EMAIL_SECONDS=300
